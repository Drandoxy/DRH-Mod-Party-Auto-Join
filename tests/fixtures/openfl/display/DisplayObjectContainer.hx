package openfl.display;class DisplayObjectContainer extends DisplayObject {public var children:Array<DisplayObject>=[];public var mouseChildren=true;public var numChildren(get,never):Int;function get_numChildren(){return children.length;}public function addChild(o:DisplayObject):DisplayObject{children.push(o);o.parent=this;return o;}public function removeChild(o:DisplayObject):DisplayObject{children.remove(o);o.parent=null;return o;}public function addChildAt(o:DisplayObject,i:Int){children.insert(i,o);o.parent=this;return o;}public function getChildIndex(o:DisplayObject){return children.indexOf(o);}public function getChildAt(i:Int):DisplayObject{return children[i];}public function getChildByName(n:String):DisplayObject{for(o in children)if(o.name==n)return o;return null;}}